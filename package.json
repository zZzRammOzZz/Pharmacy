{
  "name": "pharmacyos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:sdk": "npm run build -w @pharmacyos/license-sdk",
    "setup": "npm run build:sdk && npm run setup -w @pharmacyos/api",
    "dev:api": "npm run dev -w @pharmacyos/api",
    "dev:admin": "npm run dev -w @pharmacyos/admin",
    "dev:counter": "npm run dev -w @pharmacyos/counter",
    "dev": "npm run build:sdk && concurrently -n api,admin,counter -c green,blue,magenta \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:counter\"",
    "test:sdk": "npm run test -w @pharmacyos/license-sdk"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
